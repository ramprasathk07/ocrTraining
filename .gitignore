# Generated data, checkpoints, predictions
outputs/

# Evaluation reports: before/after comparisons quote private document text.
# report/prompts/ (prompt versions, history, leaderboard: no document text) is tracked.
report/*
!report/prompts/
!report/README.md

# Golden data is private and contains personal information. Never commit it.
dataEngine/data/

# Private planning notes (chat exports)
docs/ChatGPT-*.md

