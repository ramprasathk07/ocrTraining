# Experiment tracking keys. Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Training and evaluation read .env at start. A tracker is on when its key / URI is set;
# leave it empty to switch that tracker off. Comments must be on their own line.
#
# Sent: losses, learning rate, scores, gate results, configs, report_<split>.json and
# (if switched on below) checkpoints. Never sent: predictions or reports with private text.
# Checkpoints from Stage 1C on are trained on golden data (personal information):
# upload them only to a server your team controls.

# --- Weights & Biases (https://wandb.ai/authorize) ---
WANDB_API_KEY=
WANDB_PROJECT=hindi-doc-ocr
# team name; empty = your own account
WANDB_ENTITY=
# checkpoint = upload every saved checkpoint, end = only the final adapter, false = metrics only
WANDB_LOG_MODEL=checkpoint

# --- MLflow ---
# e.g. http://127.0.0.1:9898 on the GPU server (tracking/README.md), or a local database:
# sqlite:///outputs/mlflow.db
MLFLOW_TRACKING_URI=
# basic-auth servers; token servers use MLFLOW_TRACKING_TOKEN instead
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=hindi-doc-ocr
# TRUE = upload every saved checkpoint, FALSE = metrics only
HF_MLFLOW_LOG_ARTIFACTS=TRUE
